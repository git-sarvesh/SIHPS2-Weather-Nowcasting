# =============================================================================
# Hyper-Local Weather Nowcasting System (SIHPS) - environment template
# Copy to `.env` and adjust. ALL values have safe defaults for demo mode,
# so the prototype starts with zero credentials.
# =============================================================================

# --- Application -------------------------------------------------------------
SIHPS_ENV=development                 # development | staging | production
SIHPS_LOG_LEVEL=INFO
SIHPS_DEMO_MODE=true                  # true => synthetic data, no MOSDAC/IMDAA access
SIHPS_API_V1_PREFIX=/api/v1
SIHPS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost

# --- Database (PostgreSQL + PostGIS in Docker; SQLite fallback for local dev) -
SIHPS_DB_BACKEND=sqlite               # sqlite | postgres
SIHPS_DATABASE_URL=sqlite:///./data/sihps.db
# SIHPS_DATABASE_URL=postgresql+psycopg2://sihps:sihps@postgres:5432/sihps
POSTGRES_USER=sihps
POSTGRES_PASSWORD=sihps
POSTGRES_DB=sihps

# --- Redis / Celery ----------------------------------------------------------
SIHPS_REDIS_URL=redis://localhost:6379/0
SIHPS_CELERY_BROKER_URL=redis://localhost:6379/1
SIHPS_CELERY_RESULT_BACKEND=redis://localhost:6379/2
SIHPS_INGEST_INTERVAL_MINUTES=30
SIHPS_BATCH_INFERENCE_INTERVAL_MINUTES=60

# --- Grid & model ------------------------------------------------------------
SIHPS_GRID_BBOX=77.5,29.0,80.5,31.5   # min_lon,min_lat,max_lon,max_lat (Uttarakhand demo AOI)
SIHPS_GRID_RES_KM=2.0
SIHPS_MODEL_BACKEND=auto              # auto | torch | numpy
SIHPS_MODEL_VERSION=sihps-convlstm-cha-v0.1.0
SIHPS_MC_SAMPLES=20
SIHPS_DEVICE=cpu
SIHPS_LEAD_TIMES_H=0.5,1,2,3,4,5,6

# --- Real-world data sources (Phase 5) ---------------------------------------
# Everything below is OPTIONAL. With none of it set the project runs fully
# offline on synthetic demo data and every real connector reports its blocker
# honestly through GET /api/v1/health -> data_sources.
#
# MOSDAC (INSAT-3D / INSAT-3DR) - https://www.mosdac.gov.in
#   Downloads REQUIRE an approved account. Anonymous access is limited to
#   metadata and open data; registered accounts get 3-day latency; privileged
#   accounts get all data including NRT.
#   1. Register:      https://mosdac.gov.in/signup/  (account must be approved)
#   2. Set MOSDAC_USER / MOSDAC_PASSWORD below (never commit real values)
#   3. Download with the official client https://www.mosdac.gov.in/software/mdapi.zip
#      using config.json with datasetId (e.g. 3SIMG_L1B_STD) and
#      boundingBox "77.5,29.0,80.5,31.5". `count` is capped at 100 per request.
#   4. Put the downloaded files in SIHPS_MOSDAC_DIR.
MOSDAC_USER=
MOSDAC_PASSWORD=
MOSDAC_BASE_URL=https://www.mosdac.gov.in
#: Directory holding already-downloaded INSAT L1B/L2 NetCDF or HDF files.
SIHPS_MOSDAC_DIR=

# NCMRWF RDS (IMDAA reanalysis / MERA rainfall) - https://rds.ncmrwf.gov.in
#   NOT YET USED: the catalog API needs no credentials, but bulk downloads do.
#   See docs/phase6_real_data_acquisition.md for the full blocker analysis.
#   Published coverage: IMDAA 1979-2020 (3-hourly, ~12 km pressure levels);
#   MERA 2020-2025 (hourly rainfall, 4 km).
IMDAA_BASE_URL=https://rds.ncmrwf.gov.in
SIHPS_IMDAA_DIR=
# Credentials for the account-gated bulk download service (optional).
#
# VERIFIED 2026-09-26 against the live portal: the metadata endpoints
# (GET /datasets/catalog, GET /datasets/{slug}) are PUBLIC, but every endpoint
# that moves data returns 401 without a bearer token.
#   POST   /auth/login   -> {access_token, token_type}
#   POST   /jobs         -> submit a JobCreateRequest     (401 unauth.)
#   GET    /jobs/id/{id} -> poll for COMPLETED + file_url  (401 unauth.)
#   GET    /jobs/my      -> list your own jobs             (401 unauth.)
# 1. Register: https://rds.ncmrwf.gov.in/  (email + password)
# 2. Set SIHPS_RDS_EMAIL / SIHPS_RDS_PASSWORD below (never commit real values)
# 3. Verify:  python -m app.ingestion.realtime.imdaa_acquire --check
# 4. Acquire: python -m app.ingestion.realtime.imdaa_acquire --year 2019 --month 07
SIHPS_RDS_EMAIL=
SIHPS_RDS_PASSWORD=
SIHPS_RDS_API_URL=https://rds.ncmrwf.gov.in/api
SIHPS_RDS_USER=
SIHPS_RDS_PASSWORD=

# IMD station / gridded rainfall
#   No documented credential-free automated endpoint was found, so stage files
#   manually: CSV (station_id,lat,lon,time,rain_mm) or NetCDF.
SIHPS_IMD_DIR=

# --- Alerts ------------------------------------------------------------------
SIHPS_ALERT_MIN_PROBABILITY=0.6
SIHPS_ALERT_WEBHOOK_TIMEOUT_S=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nowcast-alerts@example.org

# --- Frontend ----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
