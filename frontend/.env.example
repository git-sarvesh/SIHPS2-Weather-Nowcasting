# Frontend environment. Copy to `.env.local` and adjust if the backend is not
# on the default port. These match the names already used in the repository
# .env.example, so no new configuration surface is introduced.

# Base URL of the FastAPI backend, including the version prefix.
# Leave this UNSET for local development: the app then uses the relative default
# `/api/v1`, which Vite proxies to http://127.0.0.1:8000 on the same origin and
# therefore needs no CORS allowance. Set it to an absolute URL for a production
# build served from a different host.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Risk Map basemap. No API key or account is required for any default below.
#
#   satellite  Esri World Imagery orthophoto + Terrarium hillshade + OpenFreeMap
#              labels/boundaries (default; the operational mode)
#   terrain    OpenTopoMap topographic relief + hillshade + OpenFreeMap overlay
#   street     OpenFreeMap "liberty" full vector cartography
#
# The map opens on Uttarakhand. To point satellite imagery at a different
# keyless XYZ raster service, set VITE_SATELLITE_TILE_URL to its tile template.
# VITE_MAP_STYLE_PRESET=satellite
# VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Optional: request the backend health endpoint more often than the default 30s.
VITE_HEALTH_POLL_MS=30000
